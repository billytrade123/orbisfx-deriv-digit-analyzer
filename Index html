
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OrbisFX Live Tick Test</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080d16;color:#edf4ff;font-family:Arial,sans-serif;padding:18px}
main{max-width:600px;margin:auto}
h1{color:#55d6ff;margin-bottom:5px}
.sub{color:#8d9bb1;font-size:14px}
.panel{background:#111a29;border:1px solid #25344b;border-radius:14px;padding:17px;margin:16px 0}
label{display:block;color:#aab9ce;margin:12px 0 7px}
select,input,button{width:100%;padding:13px;border-radius:9px;border:1px solid #33445e;background:#0b1220;color:white;font-size:15px}
button{background:#167cbd;border:0;font-weight:bold;margin-top:12px}
button:disabled{opacity:.6}
.status{font-weight:bold;color:#ffc857}
.price{font-size:32px;font-weight:bold;margin:12px 0;overflow-wrap:anywhere}
.digit{font-size:55px;font-weight:bold;color:#55d6ff}
.muted{color:#92a2b8;font-size:13px}
.digits{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}
.digitbox{background:#202e43;padding:10px 13px;border-radius:8px;font-weight:bold}
#log{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;color:#9eb3ce}
</style>
</head>
<body>
<main>
<h1>ORBISFX</h1>
<div class="sub">DERIV LIVE TICK TEST · REAL-TIME DATA</div>

<div class="panel">
<label for="symbol">Volatility market</label>
<select id="symbol">
<option value="1HZ100V">Volatility 100 (1s) Index</option>
<option value="1HZ75V">Volatility 75 (1s) Index</option>
<option value="1HZ50V">Volatility 50 (1s) Index</option>
<option value="1HZ25V">Volatility 25 (1s) Index</option>
<option value="1HZ10V">Volatility 10 (1s) Index</option>
<option value="R_100">Volatility 100 Index</option>
<option value="R_75">Volatility 75 Index</option>
<option value="R_50">Volatility 50 Index</option>
<option value="R_25">Volatility 25 Index</option>
<option value="R_10">Volatility 10 Index</option>
</select>
<label for="appid">Deriv App ID</label>
<input id="appid" type="number" placeholder="Enter your registered App ID">
<button id="connect">CONNECT LIVE DATA</button>
<div style="margin-top:15px">Connection: <span id="status" class="status">Not connected</span></div>
<div id="message" class="muted">Enter your App ID, then connect.</div>
</div>

<div class="panel">
<div class="muted">LIVE MARKET PRICE</div>
<div id="price" class="price">Waiting for data...</div>
<div class="muted">Latest tick time: <span id="ticktime">—</span></div>
</div>

<div class="panel">
<div class="muted">LAST DIGIT</div>
<div id="lastdigit" class="digit">—</div>
<div class="muted">Last-digit history (newest first)</div>
<div id="digits" class="digits"></div>
</div>

<div class="panel">
<strong>Live test log</strong>
<p id="log">Ready to connect.</p>
<p class="muted">This page displays market ticks, not guaranteed trading signals.</p>
</div>
</main>

<script>
const $ = id => document.getElementById(id);
let ws = null;
let history = [];
let connected = false;

function status(text, color="#ffc857") {
  $("status").textContent = text;
  $("status").style.color = color;
}
function log(text) {
  $("log").textContent = new Date().toLocaleTimeString() + " — " + text;
}
function disconnect() {
  connected = false;
  if (ws) {
    const old = ws;
    ws = null;
    old.onclose = null;
    old.onerror = null;
    old.onmessage = null;
    old.close();
  }
}
$("connect").addEventListener("click", () => {
  disconnect();
  const appid = $("appid").value.trim();
  const symbol = $("symbol").value;
  if (!appid) {
    status("App ID required");
    $("message").textContent = "Enter your registered Deriv App ID first.";
    return;
  }
  if (!/^\d+$/.test(appid)) {
    status("Invalid App ID");
    return;
  }

  history = [];
  $("digits").replaceChildren();
  $("lastdigit").textContent = "—";
  $("price").textContent = "Waiting for data...";
  $("ticktime").textContent = "—";
  $("connect").disabled = true;
  status("Connecting...");
  $("message").textContent = "Opening live market connection...";
  log("Connecting to Deriv WebSocket.");

  try {
    ws = new WebSocket(
      "wss://ws.derivws.com/websockets/v3?app_id=" +
      encodeURIComponent(appid)
    );
  } catch (e) {
    status("Connection error");
    $("message").textContent = e.message;
    $("connect").disabled = false;
    return;
  }

  const socket = ws;
  socket.onopen = () => {
    if (ws !== socket) return;
    connected = true;
    status("Connected", "#55e6a5");
    $("message").textContent = "Requesting live ticks...";
    socket.send(JSON.stringify({
      ticks: symbol,
      subscribe: 1
    }));
    log("WebSocket opened. Requested " + symbol);
  };

  socket.onmessage = event => {
    if (ws !== socket) return;
    let data;
    try { data = JSON.parse(event.data); }
    catch { return; }

    if (data.error) {
      status("API error");
      $("message").textContent = data.error.message || "Request failed";
      log("API error: " + (data.error.message || "Unknown error"));
      return;
    }

    if (data.msg_type === "tick" && data.tick) {
      const tick = data.tick;
      const quote = String(tick.quote);
      const match = quote.match(/\.(\d+)/);
      const digit = Number(
        match ? match[1].slice(-1) : quote.slice(-1)
      );

      $("price").textContent = quote;
      $("lastdigit").textContent = digit;
      $("ticktime").textContent =
        tick.epoch ? new Date(tick.epoch * 1000).toLocaleTimeString() : "—";
      $("message").textContent = "Receiving live ticks for " + symbol;
      status("LIVE", "#55e6a5");
      history.unshift(digit);
      history = history.slice(0, 10);
      $("digits").replaceChildren();
      history.forEach(d => {
        const span = document.createElement("span");
        span.className = "digitbox";
        span.textContent = d;
        $("digits").appendChild(span);
      });
      log("Tick received. Last digit: " + digit);
    }
  };

  socket.onerror = () => {
    if (ws !== socket) return;
    status("Connection error");
    $("message").textContent =
      "Connection failed. Check your internet and App ID.";
    log("WebSocket error.");
  };

  socket.onclose = () => {
    if (ws !== socket) return;
    ws = null;
    connected = false;
    status("Disconnected");
    $("message").textContent = "Connection closed. Tap Connect to retry.";
    $("connect").disabled = false;
    log("Connection closed.");
  };
});

$("symbol").addEventListener("change", () => {
  if (connected) $("connect").click();
});
</script>
</body>
</html>
